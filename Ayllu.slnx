    <File Path="certs/ayllu.pfx" />
  </Folder>
  <Folder Name="/Ayllu/scripts/">
    <File Path="scripts/cert-gen.ps1" />
  </Folder>
  <Folder Name="/Ayllu/src/" />
  <Folder Name="/Ayllu/src/client/">
