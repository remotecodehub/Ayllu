    </Project>
  </Folder>
  <Folder Name="/Ayllu/src/sdk/">
    <Project Path="src/sdk/Ayllu.Sdk/Ayllu.Sdk.csproj" />
  </Folder>
  <Folder Name="/Ayllu/src/server/">
    <Project Path="src/server/Ayllu.Application/Ayllu.Application.csproj" />
    <Project Path="src/server/Ayllu.Composition/Ayllu.Composition.csproj" />
    <Project Path="src/server/Ayllu.Domain/Ayllu.Domain.csproj" />
    <Project Path="src/server/Ayllu.Infrastructure/Ayllu.Infrastructure.csproj" />
    <Project Path="src/server/Ayllu/Ayllu.csproj" />
  </Folder>
  <Project Path="docker-compose.dcproj">
    <Platform Project="AnyCPU" />
    <Build />
  </Project>
</Solution>
