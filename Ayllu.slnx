<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/.github/" />
  <Folder Name="/.github/ISSUE_TEMPLATE/">
    <File Path=".github/ISSUE_TEMPLATE/bug.yml" />
    <File Path=".github/ISSUE_TEMPLATE/feature.yml" />
    <File Path=".github/ISSUE_TEMPLATE/featureset.yml" />
  </Folder>
  <Folder Name="/.github/workflows/">
    <File Path=".github/workflows/build.yaml" />
  </Folder>
  <Folder Name="/certs/">
    <File Path="certs/ayllu.pfx" />
  </Folder>
  <Folder Name="/Itens de Solução/">
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
  </Folder>
  <Folder Name="/scripts/">
    <File Path="scripts/cert-gen.ps1" />
    <File Path="scripts/Generate-KiotaClient.ps1" />
    <File Path="scripts/migrate-db.ps1" />
    <File Path="scripts/provision-db.sh" />
  </Folder>
  <Folder Name="/scripts/sqlcmd/">
    <File Path="scripts/sqlcmd/Dockerfile" />
    <File Path="scripts/sqlcmd/run-provision.sh" />
    <File Path="scripts/sqlcmd/tables_sqlServer.sql" />
  </Folder>
  <Folder Name="/Solution Items/">
    <File Path=".gitignore" />
  </Folder>
  <Folder Name="/src/" />
  <Folder Name="/src/mobile/">
    <File Path="src/mobile/Directory.Build.props" />
    <Project Path="src/mobile/Ayllu.Mobile.Application/Ayllu.Mobile.Application.csproj" />
    <Project Path="src/mobile/Ayllu.Mobile.Client/Ayllu.Mobile.Client.csproj" />
    <Project Path="src/mobile/Ayllu.Mobile.Composition/Ayllu.Mobile.Composition.csproj" />
    <Project Path="src/mobile/Ayllu.Mobile.Domain/Ayllu.Mobile.Domain.csproj" />
    <Project Path="src/mobile/Ayllu.Mobile.Infrastructure/Ayllu.Mobile.Infrastructure.csproj" />
    <Project Path="src/mobile/Ayllu.Mobile.Presentation/Ayllu.Mobile.Presentation.csproj">
      <Deploy Solution="Debug|Any CPU" />
    </Project>
  </Folder>
  <Folder Name="/src/sdk/">
    <Project Path="src/sdk/Ayllu.Api.Sdk/Ayllu.Api.Sdk.csproj" />
  </Folder>
  <Folder Name="/src/web/">
    <Project Path="src/web/Ayllu.Web.Application/Ayllu.Web.Application.csproj" />
    <Project Path="src/web/Ayllu.Web.Composition/Ayllu.Web.Composition.csproj" />
    <Project Path="src/web/Ayllu.Web.Domain/Ayllu.Web.Domain.csproj" />
    <Project Path="src/web/Ayllu.Web.Infrastructure/Ayllu.Web.Infrastructure.csproj" />
    <Project Path="src/web/Ayllu.Web/Ayllu.Web.csproj" />
  </Folder>
  <Project Path="docker-compose.dcproj">
    <Platform Project="AnyCPU" />
    <Build />
  </Project>
</Solution>
