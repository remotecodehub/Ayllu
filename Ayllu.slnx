<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="x64" />
    <Platform Name="x86" />
  </Configurations>
  <Folder Name="/Ayllu/">
    <File Path=".gitattributes" />
    <File Path=".gitignore" />
    <File Path="DependencyGraph.html" />
    <File Path="dotnet-tools.json" />
    <File Path="global.json" />
    <File Path="LICENSE.md" />
  </Folder>
  <File Path=".gitattributes" />
  <File Path=".gitignore" />
  <Folder Name="/Ayllu/.github/" />
  <Folder Name="/Ayllu/.github/ISSUE_TEMPLATE/">
    <File Path=".github/ISSUE_TEMPLATE/bug.yml" />
    <File Path=".github/ISSUE_TEMPLATE/feature.yml" />
    <File Path=".github/ISSUE_TEMPLATE/featureset.yml" />
  </Folder>
  <Folder Name="/Ayllu/.github/workflows/">
    <File Path=".github/workflows/build.yaml" />
  </Folder>
