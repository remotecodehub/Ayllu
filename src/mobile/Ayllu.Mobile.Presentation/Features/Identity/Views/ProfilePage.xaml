<?xml version="1.0" encoding="UTF-8" ?>
<uranium:UraniumContentPage x:Class="Ayllu.Mobile.Presentation.Features.Identity.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:uranium="clr-namespace:UraniumUI.Pages;assembly=UraniumUI"
    xmlns:vm="clr-namespace:Ayllu.Mobile.Presentation.Features.Identity.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:DataType="vm:ProfileViewModel"
    x:Name="PageProfile">
    
    <ScrollView
        Loaded="Load">
        <VerticalStackLayout
        Padding="24"
        Spacing="16"
        HorizontalOptions="Center"
        MaximumWidthRequest="420">

            <Label
            Text="Welcome back"
            FontSize="24"
            FontAttributes="Bold" />

            <input:FormView SubmitCommand="{Binding UpdateCommand}">

                <Entry
                Placeholder="Email"
                Keyboard="Email"
                Text="{Binding Email}" />

                <Entry
                Placeholder="First Name"
                Text="{Binding FirstName}" />

                <Entry
                Placeholder="Surame"
                Text="{Binding LastName}" />

                <Entry
                Placeholder="Pnone Number"
                Text="{Binding PhoneNumber}" />

                <Entry
                Placeholder="Username"
                Text="{Binding Username}" />

                <Entry
                Placeholder="Culture"
                Text="{Binding Culture}" />

                <Button
                Text="Sign in"
                Command="{Binding UpdateCommand}" />

            </input:FormView>

        </VerticalStackLayout>
    </ScrollView>
</uranium:UraniumContentPage>