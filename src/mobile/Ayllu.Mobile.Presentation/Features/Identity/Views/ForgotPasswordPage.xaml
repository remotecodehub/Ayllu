<?xml version="1.0" encoding="UTF-8" ?>
<uranium:UraniumContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="clr-namespace:UraniumUI.Pages;assembly=UraniumUI"
    xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
    xmlns:local="clr-namespace:Ayllu.Mobile.Presentation.Features.Identity.Views"
    xmlns:vm="clr-namespace:Ayllu.Mobile.Presentation.Features.Identity.ViewModels"
    x:Class="Ayllu.Mobile.Presentation.Features.Identity.Views.ForgotPasswordPage"
    x:DataType="vm:ForgotPasswordViewModel"
    x:Name="PageForgotPassword">


    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="16"
            HorizontalOptions="Center"
            MaximumWidthRequest="420">

            <Label
                Text="Welcome back"
                FontSize="24"
                FontAttributes="Bold" />

            <input:FormView SubmitCommand="{Binding SubmitCommand}">

                <Entry
                    Placeholder="Email"
                    Keyboard="Email"
                    Text="{Binding Email}" />

                <Button
                    Text="Sign in"
                    Command="{Binding SubmitCommand}" />
            </input:FormView>

        </VerticalStackLayout>
    </ScrollView>
</uranium:UraniumContentPage>