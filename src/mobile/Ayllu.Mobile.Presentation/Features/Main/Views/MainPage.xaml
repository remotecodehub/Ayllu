<?xml version="1.0" encoding="utf-8" ?>
<uranium:UraniumContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:uranium="clr-namespace:UraniumUI.Pages;assembly=UraniumUI"
    xmlns:input="clr-namespace:InputKit.Shared.Controls;assembly=InputKit.Maui"
    xmlns:vm="clr-namespace:Ayllu.Mobile.Presentation.Features.Main.ViewModels"
    x:Class="Ayllu.Mobile.Presentation.Views.Main.MainPage"
    x:DataType="vm:MainViewModel"
    x:Name="PageMain">

    <StackLayout>
        <Label Text="{Binding WelcomeLabel}"
            Padding="100"
            HorizontalOptions="Center"
            VerticalOptions="Center"/>
    </StackLayout>

</uranium:UraniumContentPage>
